# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public credentials (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used for auth email redirect URLs
NEXT_PUBLIC_SITE_URL=

# ─── Gemini AI (Phase 5) ──────────────────────────────────────────────────────
# IMPORTANT: These are SERVER-ONLY variables.
# Never prefix with NEXT_PUBLIC_ — that would expose them to the browser.

# Your Google Gemini API key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# The Gemini model to use for contract analysis.
# Can be changed without code changes to switch between model tiers.
# Default: gemini-3.6-flash (fast, cost-effective, current)
# Alternative: gemini-2.5-pro (more capable, higher cost)
GEMINI_MODEL=gemini-3.6-flash

# ─── Analysis configuration (optional) ───────────────────────────────────────
# Maximum characters of contract text sent to the AI model.
# Documents exceeding this are truncated. Default: 200000 (~150k words).
MAX_ANALYSIS_CHARS=200000
